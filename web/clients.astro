---
import Layout from "../layouts/Layout.astro";

// Store links. Each is null until the listing is live; the card then shows "Store listing
// pending" instead of a button. Fill these in as the reviews clear.
const links: Record<"ios" | "android" | "chrome" | "firefox", string | null> = {
  ios: null,
  android: null,
  chrome: null,
  firefox: null,
};

const REPO = "https://github.com/randprotocol/clients";
const EXPLORER = "https://randscan.org";
const DEFAULT_RPC = "https://rpc.randprotocol.org";

const clients = [
  {
    key: "ios" as const,
    name: "iOS",
    language: "Swift",
    store: "App Store",
    via: "TestFlight while in testing, then the App Store",
    cta: "Get on the App Store",
    requires: "iOS 16 or later",
  },
  {
    key: "android" as const,
    name: "Android",
    language: "Java",
    store: "Google Play",
    via: "Google Play, open testing first",
    cta: "Get on Google Play",
    requires: "Android 8 (API 26) or later, arm64 or x86_64",
  },
  {
    key: "chrome" as const,
    name: "Chrome",
    language: "JavaScript · Manifest V3",
    store: "Chrome Web Store",
    via: "the Chrome Web Store; also installs in Edge and Brave",
    cta: "Add to Chrome",
    requires: "Chrome 116 or later",
  },
  {
    key: "firefox" as const,
    name: "Firefox",
    language: "JavaScript · Manifest V3",
    store: "Firefox Add-ons",
    via: "addons.mozilla.org",
    cta: "Add to Firefox",
    requires: "Firefox 121 or later",
  },
];

const does = [
  {
    k: "Create a wallet",
    v: "A 256-bit spend key generated on the device, shown once for you to save, and the rand1… address derived from it. Import an existing key or a wallet.key.json from the rand CLI.",
  },
  {
    k: "Receive and send",
    v: "Your balance is the set of notes only your key can open; the wallet scans the commitment tree to find them. A transfer is a 2-in-2-out bundle the wallet proves on your device and submits; nobody learns the sender, the receiver or the amount.",
  },
  {
    k: "Faucet",
    v: "On the testnet, one tap mints 100 RAND into a note only you can open.",
  },
  {
    k: "Disclose only what you choose",
    v: "Copy your viewing key and open My history on RandScan to see every note you sent or received, or copy one payment's transaction key to disclose exactly that payment and nothing else. Keys are pasted into the explorer, which decrypts in your browser and never sends them anywhere.",
  },
];

const notes = [
  { k: "Chain", v: "Chain 13, the shielded pool with staking and the call limits; wallet core built from fullnode 142e1f7" },
  { k: "RPC endpoint", v: `Settings → Network. Defaults to ${DEFAULT_RPC}; any rand-node RPC you can reach works` },
  { k: "Proving", v: "A transfer proof takes about a minute on a laptop CPU and longer on a phone or in the browser; keep the app open" },
  { k: "Status", v: "Experimental testnet software. Not audited. RAND carries no real value" },
];
---

<Layout
  title="Wallets — Rand Protocol"
  description="Rand Wallet: a shielded wallet for RAND on iOS, Android, Chrome and Firefox. Creates a spend key and rand1 address, proves transfers on your device, asks the testnet faucet, and hands you the viewing keys RandScan opens confidential transactions with."
  ogPath="/clients"
>
  <section class="container-page pt-16 md:pt-24 pb-10">
    <div class="grid md:grid-cols-12 gap-8 items-start">
      <div class="md:col-span-8">
        <div class="chip">Wallets</div>
        <h1 class="mt-4 text-4xl md:text-5xl font-medium tracking-tight">Rand Wallet</h1>
        <p class="prose-rand mt-4 max-w-2xl">
          A shielded wallet for RAND, one for each platform. It creates a spend key and a
          <span class="font-mono text-[0.95em]">rand1…</span> address, finds your notes by
          scanning the chain with your own key, proves every transfer on the device you are
          holding, requests funds from the testnet faucet, and gives you the viewing key and
          per-transaction keys that <a href={EXPLORER} class="underline decoration-[color:var(--color-border)] underline-offset-4 hover:decoration-current" target="_blank" rel="noopener noreferrer">randscan.org</a>
          opens confidential transactions with. Nothing about your balance or your payments is
          visible to anyone you have not handed a key to — and the wallet is no exception:
          it holds no account, only your notes.
        </p>
      </div>
      <div class="md:col-span-4 flex md:justify-end">
        <img src="/clients/icon-256.png" alt="Rand Wallet icon" width="112" height="112" class="rounded-[24px] shadow-sm" />
      </div>
    </div>
  </section>

  <!-- Downloads -->
  <section class="container-page">
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {clients.map((c) => {
        const href = links[c.key];
        return (
          <div class="card p-6 flex flex-col">
            <div class="flex items-center justify-between gap-3">
              <h2 class="text-xl font-medium tracking-tight">{c.name}</h2>
              <span class="tag">{href ? "Available" : "Coming to the store"}</span>
            </div>
            <div class="mt-1 text-xs text-[color:var(--color-text-mute)]">{c.language}</div>
            <dl class="mt-5 space-y-2 text-sm">
              <div>
                <dt class="text-xs text-[color:var(--color-text-mute)]">Distributed through</dt>
                <dd class="mt-0.5 text-[color:var(--color-text-soft)]">{c.via}</dd>
              </div>
              <div>
                <dt class="text-xs text-[color:var(--color-text-mute)]">Requires</dt>
                <dd class="mt-0.5 text-[color:var(--color-text-soft)]">{c.requires}</dd>
              </div>
            </dl>
            <div class="mt-6 pt-4 border-t border-[color:var(--color-border-soft)]">
              {href ? (
                <a href={href} target="_blank" rel="noopener noreferrer" class="btn-primary hover:btn-primary-hover w-full justify-center">
                  {c.cta}
                </a>
              ) : (
                <div class="text-sm text-[color:var(--color-text-mute)]">
                  Store listing pending. Until it clears review, build from source below.
                </div>
              )}
            </div>
          </div>
        );
      })}
    </div>
  </section>

  <!-- What every client does -->
  <section class="container-page mt-20">
    <div class="grid md:grid-cols-12 gap-8 items-start">
      <div class="md:col-span-4">
        <div class="chip">Every client</div>
        <h2 class="mt-4 text-3xl font-medium tracking-tight">Four apps, one wallet</h2>
        <p class="prose-rand mt-3">
          The same key file, the same address format and the same rules on every platform. A
          wallet created on the phone imports into the browser and into the
          <span class="font-mono text-[0.95em]">rand</span> CLI, and back.
        </p>
      </div>
      <div class="md:col-span-8">
        <div class="card divide-y divide-[color:var(--color-border-soft)]">
          {does.map((d) => (
            <div class="p-5 grid sm:grid-cols-12 gap-2 sm:gap-6">
              <div class="sm:col-span-3 font-medium text-sm">{d.k}</div>
              <div class="sm:col-span-9 text-sm text-[color:var(--color-text-soft)] leading-relaxed">{d.v}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- How it works / testnet notes -->
  <section class="container-page mt-20">
    <div class="grid md:grid-cols-2 gap-6">
      <div class="card p-6">
        <div class="chip">How it works</div>
        <h3 class="mt-3 text-xl font-medium tracking-tight">Proofs on your device, keys that never leave it</h3>
        <p class="mt-3 text-sm text-[color:var(--color-text-soft)] leading-relaxed">
          Every client wraps one Rust core built from the full node's own crates: the Poseidon2
          key hierarchy, the ML-KEM-768 envelopes and the zkVM prover are the node's code,
          compiled into an XCFramework for iOS, a native library for Android and WebAssembly
          for the browsers. The Swift, Java and JavaScript above it are the wallet: the RPC
          client, the note store, and the screens. Your spend key is generated locally from the
          operating system's randomness and stored in the platform's secure store; the only
          host the app talks to is the RPC endpoint you configure, and what it sends is what a
          bundle publishes anyway — commitments, nullifiers, sealed envelopes and a proof.
        </p>
      </div>
      <div class="card p-6">
        <div class="chip">Testnet notes</div>
        <h3 class="mt-3 text-xl font-medium tracking-tight">Before you send anything</h3>
        <dl class="mt-4 space-y-3 text-sm">
          {notes.map((n) => (
            <div class="grid grid-cols-12 gap-3">
              <dt class="col-span-4 text-[color:var(--color-text-mute)]">{n.k}</dt>
              <dd class="col-span-8 text-[color:var(--color-text-soft)] leading-relaxed">{n.v}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <!-- Build from source -->
  <section class="container-page mt-20 mb-24">
    <div class="grid md:grid-cols-12 gap-8 items-start">
      <div class="md:col-span-4">
        <div class="chip">Build from source</div>
        <h2 class="mt-4 text-3xl font-medium tracking-tight">Or build it yourself</h2>
        <p class="prose-rand mt-3">
          The clients repository holds the Rust core, the four apps and the packaging scripts
          for each store. The core vendors the full node at the chain 13 commit as a submodule.
        </p>
        <a href={REPO} target="_blank" rel="noopener noreferrer" class="mt-5 card p-5 flex items-center justify-between hover:border-[color:var(--color-text-mute)] transition-colors">
          <div>
            <div class="text-xs font-medium text-[color:var(--color-text-mute)]">Source</div>
            <div class="mt-1 font-medium font-mono text-sm">randprotocol/clients</div>
            <div class="text-xs text-[color:var(--color-text-mute)] mt-0.5">Apache-2.0</div>
          </div>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="text-[color:var(--color-text-mute)]"><path d="M7 17 17 7"/><path d="M7 7h10v10"/></svg>
        </a>
      </div>
      <div class="md:col-span-8">
        <div class="card overflow-hidden">
          <div class="px-5 py-3 border-b border-[color:var(--color-border-soft)] flex items-center justify-between">
            <div class="text-sm font-medium tracking-tight">Build the core, then a client</div>
            <span class="text-xs text-[color:var(--color-text-mute)] font-mono">bash</span>
          </div>
          <pre class="px-5 py-5 text-sm leading-relaxed overflow-x-auto"><code class="text-[color:var(--color-text-soft)]"><span class="text-[color:var(--color-text-mute)]"># Rust 1.98.1 (pinned; rustup installs it). Xcode 16+ for iOS, JDK 17+ with SDK 35 and NDK 27 for Android, Node 20+ for the extensions</span>
git clone {REPO}.git && cd clients
git submodule update --init                    <span class="text-[color:var(--color-text-mute)]"># core/vendor/fullnode @ 142e1f7</span>
cd core && cargo test --release && cd ..       <span class="text-[color:var(--color-text-mute)]"># the core, including a real proof (~1 min)</span>

core/scripts/build-wasm.sh                     <span class="text-[color:var(--color-text-mute)]"># → extension/shared/core/   (needs wasm-pack)</span>
core/scripts/build-ios.sh                      <span class="text-[color:var(--color-text-mute)]"># → ios/Frameworks/RandWalletCore.xcframework</span>
core/scripts/build-android.sh                  <span class="text-[color:var(--color-text-mute)]"># → android/app/src/main/jniLibs/ (needs an NDK)</span>

<span class="text-[color:var(--color-text-mute)]"># Then: ios/README.md, android/README.md, chrome/README.md, firefox/README.md</span>
</code></pre>
        </div>
      </div>
    </div>
  </section>
</Layout>
