    "Your prover does not take spend-key jobs. Pair your own prover in Settings, or send from the rand command-line wallet." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your prover does not take spend-key jobs. Pair your own prover in Settings, or send from the rand command-line wallet."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يقبل مُثبِتك مهام مفتاح الإنفاق. اقرن مُثبِتك الخاص في الإعدادات، أو أرسل من محفظة سطر الأوامر rand."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Prover nimmt keine Aufträge mit Ausgabeschlüssel an. Kopple deinen eigenen Prover in den Einstellungen oder sende aus der rand-Kommandozeilen-Wallet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu probador no acepta trabajos con clave de gasto. Vincula tu propio probador en Ajustes o envía desde la billetera de línea de comandos rand."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اثبات‌گر شما کارهای کلید خرج را نمی‌پذیرد. اثبات‌گر خودتان را در تنظیمات جفت کنید، یا از کیف پول خط فرمان rand ارسال کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre prouveur n'accepte pas les tâches avec clé de dépense. Associez votre propre prouveur dans les Paramètres, ou envoyez depuis le portefeuille en ligne de commande rand."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prover Anda tidak menerima tugas kunci belanja. Pasangkan prover milik Anda sendiri di Pengaturan, atau kirim dari dompet baris perintah rand."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo prover non accetta lavori con la chiave di spesa. Associa un tuo prover nelle Impostazioni, oppure invia dal portafoglio a riga di comando rand."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたのプルーバーは支出キーのジョブを受け付けません。設定で自分のプルーバーをペアリングするか、rand コマンドラインウォレットから送信してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내 프루버는 지출 키 작업을 받지 않습니다. 설정에서 직접 운영하는 프루버를 페어링하거나 rand 명령줄 지갑에서 보내세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pembukti anda tidak menerima kerja kunci perbelanjaan. Pasangkan pembukti anda sendiri dalam Tetapan, atau hantar daripada dompet baris perintah rand."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twój prover nie przyjmuje zadań z kluczem wydawania. Sparuj własny prover w Ustawieniach lub wyślij z portfela wiersza poleceń rand."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu provador não aceita trabalhos com chave de gasto. Pareie seu próprio provador em Configurações ou envie pela carteira de linha de comando rand."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш прувер не принимает задания с ключом расходования. Подключите собственный прувер в настройках или отправьте из консольного кошелька rand."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的证明器不接受需要花费密钥的任务。请在设置中配对你自己的证明器，或使用 rand 命令行钱包发送。"
          }
        },
        "zh-Hant-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的證明器不接受需要花費私鑰的工作。請在設定中配對你自己的證明器，或使用 rand 命令列錢包傳送。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका प्रूवर स्पेंड की वाले जॉब नहीं लेता। सेटिंग्स में अपना खुद का प्रूवर पेयर करें, या rand कमांड-लाइन वॉलेट से भेजें।"
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستاسو ثبوت جوړوونکی د لګښت کیلي دندې نه اخلي. په امستنو کې خپل ثبوت جوړوونکی جوړه کړئ، یا د rand له کمانډ لاین والټ څخه ولېږئ."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உங்கள் நிரூபிப்பான் செலவு-விசை வேலைகளை ஏற்பதில்லை. அமைப்புகளில் உங்கள் சொந்த நிரூபிப்பானை இணைக்கவும், அல்லது rand கட்டளை-வரி வாலட்டிலிருந்து அனுப்பவும்."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کا پروور اسپینڈ کی والے کام نہیں لیتا۔ ترتیبات میں اپنا پروور جوڑیں، یا rand کمانڈ لائن والیٹ سے بھیجیں۔"
          }
        }
      }
    },
    "Your prover does not take viewing-key jobs (it is older than this chain). Update it, or pair another." : {
