    "Forget this wallet on this phone? Without your spend key backup the funds are gone." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forget this wallet on this phone? Without your spend key backup the funds are gone."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل تنسى هذه المحفظة على هذا الهاتف؟ بدون نسخة احتياطية من مفتاح الإنفاق تضيع الأموال."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Wallet auf diesem Telefon vergessen? Ohne Sicherung deines Ausgabeschlüssels ist das Guthaben verloren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Olvidar esta billetera en este teléfono? Sin el respaldo de tu clave de gasto, los fondos se pierden."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این کیف پول روی این گوشی فراموش شود؟ بدون پشتیبان کلید خرج، دارایی‌ها از دست می‌روند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oublier ce portefeuille sur ce téléphone ? Sans sauvegarde de votre clé de dépense, les fonds sont perdus."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lupakan dompet ini di ponsel ini? Tanpa cadangan kunci belanja, dana Anda akan hilang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dimenticare questo portafoglio su questo telefono? Senza il backup della chiave di spesa i fondi sono persi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このスマートフォンからこのウォレットを削除しますか？支出キーのバックアップがなければ、資金は失われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 휴대폰에서 이 지갑을 삭제할까요? 지출 키 백업이 없으면 자금은 사라집니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lupakan dompet ini pada telefon ini? Tanpa sandaran kunci perbelanjaan anda, dana akan hilang."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapomnieć ten portfel na tym telefonie? Bez kopii zapasowej klucza wydawania środki przepadną."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esquecer esta carteira neste celular? Sem o backup da sua chave de gasto, os fundos se perdem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Забыть этот кошелёк на этом телефоне? Без резервной копии ключа расходования средства будут потеряны."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要在这部手机上忘记此钱包吗？如果没有花费密钥的备份，资金将无法找回。"
          }
        },
        "zh-Hant-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要在這部手機上忘記此錢包嗎？如果沒有花費私鑰的備份，資金將無法取回。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस फ़ोन पर इस वॉलेट को भूल जाएँ? आपकी स्पेंड की के बैकअप के बिना धनराशि चली जाएगी।"
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دا والټ په دې تلیفون کې هېر کړئ؟ د خپلې د لګښت کیلي له بیک اپ پرته پیسې له منځه ځي."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இந்தத் தொலைபேசியில் இந்த வாலட்டை மறக்கவா? உங்கள் செலவு விசையின் காப்புப்பிரதி இல்லாமல் நிதி இழக்கப்படும்."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اس فون پر اس والیٹ کو بھول جائیں؟ اسپینڈ کی کے بیک اپ کے بغیر فنڈز ہمیشہ کے لیے چلے جائیں گے۔"
          }
        }
      }
    },
