    "%@ answered with another key than the one this wallet pins" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ answered with another key than the one this wallet pins"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أجاب %@ بمفتاح غير المفتاح الذي تثبّته هذه المحفظة"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat mit einem anderen Schlüssel geantwortet als dem, den diese Wallet hinterlegt hat"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ respondió con una clave distinta de la que esta billetera tiene fijada"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ با کلیدی غیر از کلیدی که این کیف پول ثبت کرده پاسخ داد"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a répondu avec une autre clé que celle que ce portefeuille a enregistrée"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ menjawab dengan kunci yang berbeda dari kunci yang disematkan dompet ini"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ha risposto con una chiave diversa da quella fissata da questo portafoglio"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ が、このウォレットが固定している鍵とは別の鍵で応答しました"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 이 지갑이 고정한 키와 다른 키로 응답했습니다"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ menjawab dengan kunci yang berlainan daripada kunci yang ditetapkan oleh dompet ini"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ odpowiedział innym kluczem niż ten, który przypisuje mu ten portfel"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ respondeu com uma chave diferente da que esta carteira fixou"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ответил другим ключом, а не тем, который закреплён в этом кошельке"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 返回的密钥与此钱包固定的密钥不同"
          }
        },
        "zh-Hant-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 回應的密鑰與此錢包綁定的不同"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ने उस की के बजाय किसी दूसरी की से जवाब दिया जिसे यह वॉलेट पिन करता है"
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ د هغې کیلي پرته چې دا والټ یې ټاکلې، له بلې کیلي سره ځواب ورکړ"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ இந்த வாலட் நிர்ணயித்த விசைக்குப் பதிலாக வேறொரு விசையுடன் பதிலளித்தது"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ نے اس کی کے بجائے کسی اور کی سے جواب دیا جو یہ والیٹ اس کے لیے مقرر رکھتا ہے"
          }
        }
      }
    },
