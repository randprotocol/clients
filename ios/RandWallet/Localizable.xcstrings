    "Never share this. Anyone who has it controls your funds." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Never share this. Anyone who has it controls your funds."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تشاركه أبدًا. أي شخص يملكه يتحكم في أموالك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teile ihn niemals. Wer ihn hat, kontrolliert dein Guthaben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nunca la compartas. Cualquiera que la tenga controla tus fondos."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هرگز این را به اشتراک نگذارید. هر کس آن را داشته باشد دارایی‌های شما را در اختیار دارد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne la partagez jamais. Quiconque la détient contrôle vos fonds."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jangan pernah bagikan ini. Siapa pun yang memilikinya menguasai dana Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non condividerla mai. Chiunque la possieda controlla i tuoi fondi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "絶対に共有しないでください。これを持つ人は誰でも資金を操作できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "절대 공유하지 마세요. 이 키를 가진 사람은 누구나 자금을 통제할 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jangan sekali-kali kongsikan ini. Sesiapa yang memilikinya mengawal dana anda."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nigdy go nie udostępniaj. Każdy, kto go ma, kontroluje twoje środki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nunca compartilhe isto. Quem a tiver controla seus fundos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Никому его не показывайте. Тот, у кого он есть, распоряжается вашими средствами."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切勿分享。任何拥有它的人都能控制你的资金。"
          }
        },
        "zh-Hant-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切勿分享。任何人取得它便可控制你的資金。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसे कभी साझा न करें। जिसके पास यह है, वह आपकी धनराशि नियंत्रित करता है।"
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دا هېڅکله مه شریکوئ. هر څوک چې دا ولري، ستاسو پیسې کنټرولوي."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இதை ஒருபோதும் பகிர வேண்டாம். இதை வைத்திருக்கும் எவரும் உங்கள் நிதியைக் கட்டுப்படுத்துவார்."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یہ کبھی کسی کو نہ دیں۔ جس کے پاس یہ ہو وہ آپ کے فنڈز پر قابو رکھتا ہے۔"
          }
        }
      }
    },
