    "Encrypted with the payment: only the recipient, you and anyone either of you shows it to can read it." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encrypted with the payment: only the recipient, you and anyone either of you shows it to can read it."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مشفّرة مع الدفعة: لا يقرؤها إلا المستلم وأنت ومن يُطلعه أيٌّ منكما عليها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit der Zahlung verschlüsselt: Nur der Empfänger, du und jeder, dem einer von euch es zeigt, können es lesen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cifrado con el pago: solo el destinatario, tú y quien cualquiera de los dos se lo muestre pueden leerlo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "همراه با پرداخت رمزگذاری می‌شود: فقط گیرنده، شما و هر کسی که یکی از شما آن را به او نشان دهد می‌تواند آن را بخواند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiffré avec le paiement : seuls le destinataire, vous et toute personne à qui l'un de vous le montre pouvez le lire."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dienkripsi bersama pembayaran: hanya penerima, Anda, dan siapa pun yang diperlihatkan oleh salah satu dari Anda yang dapat membacanya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cifrato con il pagamento: solo il destinatario, tu e chiunque a cui uno di voi lo mostri potete leggerlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "支払いと一緒に暗号化されます。読めるのは受取人とあなた、そしてどちらかが見せた相手だけです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "결제와 함께 암호화됩니다. 받는 사람과 나, 그리고 둘 중 누군가가 보여 준 사람만 읽을 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disulitkan bersama pembayaran: hanya penerima, anda dan sesiapa yang ditunjukkan oleh salah seorang daripada anda boleh membacanya."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaszyfrowane razem z płatnością: przeczytać je możecie tylko odbiorca, ty i każdy, komu któreś z was je pokaże."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Criptografado com o pagamento: só o destinatário, você e quem um de vocês o mostrar podem lê-lo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шифруется вместе с платежом: прочитать его могут только получатель, вы и те, кому кто-либо из вас его покажет."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "随付款一起加密：只有收款人、你，以及你们任一方出示给的人能读取。"
          }
        },
        "zh-Hant-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "與付款一同加密：只有收款人、你，以及你們任何一方出示給的人才能讀取。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "भुगतान के साथ एन्क्रिप्ट किया गया: केवल प्राप्तकर्ता, आप और वे लोग जिन्हें आप दोनों में से कोई इसे दिखाए, इसे पढ़ सकते हैं।"
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "له تادیې سره کوډ شوی: یوازې ترلاسه کوونکی، تاسو او هر هغه څوک چې تاسو دواړو کې یو یې ورته وښيي، لوستلی یې شي."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "கட்டணத்துடன் மறையாக்கப்பட்டது: பெறுநர், நீங்கள், உங்களில் ஒருவர் காட்டும் எவர் மட்டுமே இதைப் படிக்க முடியும்."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ادائیگی کے ساتھ خفیہ کردہ: صرف وصول کنندہ، آپ، اور وہ جسے آپ دونوں میں سے کوئی دکھائے، اسے پڑھ سکتے ہیں۔"
          }
        }
      }
    },
    "Enter an amount like 1.5." : {
      "localizations" : {
