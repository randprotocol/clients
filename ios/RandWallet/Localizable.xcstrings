    "%@The %@ provers are all busy right now; try again in a minute, or pair your own prover in Settings." : {
      "comment" : "First %@ is a preceding sentence ending in a space, or empty; second is the pool name (RandProtocol).",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@The %2$@ provers are all busy right now; try again in a minute, or pair your own prover in Settings."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@مُثبِتات %@ كلها مشغولة الآن، حاول مرة أخرى بعد دقيقة، أو اقرن مُثبِتك الخاص في الإعدادات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@Die %@-Prover sind gerade alle ausgelastet; versuche es in einer Minute erneut oder kopple deinen eigenen Prover in den Einstellungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@Los probadores de %@ están todos ocupados en este momento; inténtalo de nuevo en un minuto o vincula tu propio probador en Ajustes."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@اثبات‌گرهای %@ اکنون همگی مشغول‌اند؛ یک دقیقه دیگر دوباره امتحان کنید، یا اثبات‌گر خودتان را در تنظیمات جفت کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@Les prouveurs %@ sont tous occupés pour le moment ; réessayez dans une minute, ou associez votre propre prouveur dans les Paramètres."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@Prover %@ sedang sibuk semua; coba lagi sebentar lagi, atau pasangkan prover milik Anda sendiri di Pengaturan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@I prover di %@ sono tutti occupati in questo momento; riprova tra un minuto, oppure associa un tuo prover nelle Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@%@ のプルーバーは現在すべて混み合っています。1分ほどしてからもう一度試すか、設定で自分のプルーバーをペアリングしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@지금은 %@ 프루버가 모두 사용 중입니다. 잠시 후 다시 시도하거나, 설정에서 직접 운영하는 프루버를 페어링하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@Semua pembukti %@ sedang sibuk sekarang; cuba lagi dalam seminit, atau pasangkan pembukti anda sendiri dalam Tetapan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@Wszystkie provery %@ są teraz zajęte; spróbuj ponownie za minutę lub sparuj własny prover w Ustawieniach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@Os provadores %@ estão todos ocupados agora; tente de novo em um minuto ou pareie seu próprio provador em Configurações."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@Все пруверы %@ сейчас заняты; попробуйте через минуту или подключите свой прувер в настройках."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@%@ 证明器目前全部繁忙；请一分钟后重试，或在设置中配对你自己的证明器。"
          }
        },
        "zh-Hant-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@%@ 證明器目前全部繁忙；請一分鐘後再試，或在設定中配對你自己的證明器。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@%@ प्रूवर अभी सभी व्यस्त हैं; एक मिनट में फिर से कोशिश करें, या सेटिंग्स में अपना खुद का प्रूवर पेयर करें।"
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@د %@ ثبوت جوړوونکي اوس ټول بوخت دي؛ یوه دقیقه وروسته بیا هڅه وکړئ، یا په امستنو کې خپل ثبوت جوړوونکی جوړه کړئ."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@%@ நிரூபிப்பான்கள் அனைத்தும் இப்போது பணியில் உள்ளன; ஒரு நிமிடத்தில் மீண்டும் முயலவும், அல்லது அமைப்புகளில் உங்கள் சொந்த நிரூபிப்பானை இணைக்கவும்."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@%@ پروور اس وقت سب مصروف ہیں؛ ایک منٹ بعد دوبارہ کوشش کریں، یا ترتیبات میں اپنا پروور جوڑیں۔"
          }
        }
      }
    },
    "%@The %@ provers cannot be reached right now (%@). Try again later, or pair your own prover in Settings." : {
      "comment" : "First %@ is a preceding sentence ending in a space, or empty; second is the pool name; third the reasons.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@The %2$@ provers cannot be reached right now (%3$@). Try again later, or pair your own prover in Settings."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@يتعذّر الوصول إلى مُثبِتات %@ الآن (%@). حاول لاحقًا، أو اقرن مُثبِتك الخاص في الإعدادات."
          }
        },
        "de" : {
          "stringUnit" : {
