    "Anyone can pay this address. It reveals nothing about what you hold." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anyone can pay this address. It reveals nothing about what you hold."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستطيع أي شخص الدفع إلى هذا العنوان. لا يكشف شيئًا عمّا تملكه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder kann an diese Adresse zahlen. Sie verrät nichts darüber, was du besitzt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cualquiera puede pagar a esta dirección. No revela nada de lo que tienes."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هر کسی می‌تواند به این نشانی پرداخت کند. این نشانی چیزی درباره‌ی دارایی شما فاش نمی‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "N'importe qui peut payer cette adresse. Elle ne révèle rien de ce que vous détenez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siapa pun dapat membayar ke alamat ini. Alamat ini tidak mengungkapkan apa pun tentang aset yang Anda miliki."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiunque può pagare questo indirizzo. Non rivela nulla di ciò che possiedi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "誰でもこのアドレスに支払えます。このアドレスから保有資産について何かが明らかになることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "누구나 이 주소로 결제할 수 있습니다. 이 주소로는 보유 자산에 대해 아무것도 드러나지 않습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesiapa sahaja boleh membayar ke alamat ini. Ia tidak mendedahkan apa-apa tentang apa yang anda pegang."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każdy może zapłacić na ten adres. Nie zdradza on niczego o tym, co posiadasz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualquer pessoa pode pagar para este endereço. Ele não revela nada sobre o que você tem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На этот адрес может заплатить кто угодно. Он ничего не раскрывает о ваших средствах."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任何人都可以向此地址付款。它不会透露你持有的任何资产。"
          }
        },
        "zh-Hant-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任何人都可以向此地址付款。它不會透露你持有的任何資產。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई भी इस पते पर भुगतान कर सकता है। इससे यह पता नहीं चलता कि आपके पास क्या है।"
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هر څوک دې پتې ته پیسې ورکولی شي. دا ستاسو د شتمنۍ په اړه هېڅ نه څرګندوي."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இந்த முகவரிக்கு யார் வேண்டுமானாலும் பணம் செலுத்தலாம். நீங்கள் வைத்திருப்பது பற்றி இது எதையும் வெளிப்படுத்தாது."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کوئی بھی اس پتے پر ادائیگی کر سکتا ہے۔ یہ اس بارے میں کچھ ظاہر نہیں کرتا کہ آپ کے پاس کیا ہے۔"
          }
        }
      }
    },
