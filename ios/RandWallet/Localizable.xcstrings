    "Accepted by the node; not yet seen in a block. It will show in Activity once committed." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accepted by the node; not yet seen in a block. It will show in Activity once committed."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قبلتها العقدة، ولم تظهر في كتلة بعد. ستظهر في النشاط بعد إدراجها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vom Knoten angenommen; noch in keinem Block gesehen. Sie erscheint in der Aktivität, sobald sie bestätigt ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aceptada por el nodo; todavía no aparece en un bloque. Se mostrará en Actividad cuando se confirme."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "گره آن را پذیرفته است؛ هنوز در هیچ بلاکی دیده نشده. پس از ثبت در فعالیت نمایش داده می‌شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accepté par le nœud ; pas encore vu dans un bloc. Il apparaîtra dans Activité une fois validé."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diterima oleh node; belum terlihat di blok. Akan muncul di Aktivitas setelah dikonfirmasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accettato dal nodo; non ancora visto in un blocco. Comparirà in Attività una volta confermato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ノードに受け付けられましたが、まだブロックに含まれていません。確定するとアクティビティに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "노드가 받아들였지만 아직 블록에 포함되지 않았습니다. 확정되면 활동에 표시됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diterima oleh nod; belum dilihat dalam blok. Ia akan dipaparkan dalam Aktiviti setelah dikomit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przyjęte przez węzeł; jeszcze nie widać go w bloku. Pojawi się w Aktywności po zatwierdzeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aceita pelo nó; ainda não vista em um bloco. Vai aparecer em Atividade quando for confirmada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Принято узлом; в блоке пока не видно. Появится в «Активности» после подтверждения."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "节点已接受；尚未出现在区块中。上链后会显示在“活动”中。"
          }
        },
        "zh-Hant-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "節點已接受；尚未出現在區塊中。確認後會在「記錄」中顯示。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नोड ने स्वीकार कर लिया; अभी किसी ब्लॉक में नहीं दिखा। कमिट होने पर यह गतिविधि में दिखेगा।"
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "د نوډ لخوا ومنل شو؛ لا په کوم بلاک کې نه دی لیدل شوی. کله چې ثبت شي، په فعالیت کې به ښکاره شي."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "நோட் ஏற்றுக்கொண்டது; இன்னும் எந்தப் பிளாக்கிலும் காணப்படவில்லை. உறுதியானதும் செயல்பாட்டில் தோன்றும்."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نوڈ نے قبول کر لیا؛ ابھی کسی بلاک میں نظر نہیں آیا۔ کمٹ ہونے پر یہ سرگرمی میں دکھائی دے گا۔"
          }
        }
      }
    },
