    "Not marked as your own: it can read this wallet's whole history. It cannot spend." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not marked as your own: it can read this wallet's whole history. It cannot spend."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "غير مُعلَّم على أنه مُثبِتك الخاص: يستطيع قراءة سجل هذه المحفظة كاملًا. لا يمكنه الإنفاق."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht als dein eigener markiert: Er kann den gesamten Verlauf dieser Wallet lesen. Er kann nichts ausgeben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No está marcado como propio: puede leer todo el historial de esta billetera. No puede gastar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "به‌عنوان اثبات‌گر خودتان علامت نخورده است: می‌تواند کل تاریخچه‌ی این کیف پول را بخواند. نمی‌تواند خرج کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non marqué comme le vôtre : il peut lire tout l'historique de ce portefeuille. Il ne peut pas dépenser."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak ditandai sebagai milik Anda: prover ini dapat membaca seluruh riwayat dompet ini. Prover ini tidak dapat membelanjakan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non contrassegnato come tuo: può leggere tutta la cronologia di questo portafoglio. Non può spendere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自分のものとして指定されていません。このウォレットの全履歴を読めます。支出はできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내 프루버로 표시되지 않았습니다. 이 지갑의 전체 내역을 읽을 수 있습니다. 지출할 수는 없습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak ditandakan sebagai milik anda: ia boleh membaca seluruh sejarah dompet ini. Ia tidak boleh berbelanja."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie oznaczony jako twój własny: może czytać całą historię tego portfela. Nie może wydawać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não marcado como seu: ele pode ler todo o histórico desta carteira. Não pode gastar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не отмечен как ваш собственный: он может читать всю историю этого кошелька. Тратить он не может."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未标记为你自己的证明器：它能读取此钱包的全部历史记录。它不能花费资金。"
          }
        },
        "zh-Hant-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未標記為你自己的：它能讀取此錢包的全部記錄，但不能花費。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके अपने के रूप में चिह्नित नहीं: यह इस वॉलेट का पूरा इतिहास पढ़ सकता है। यह खर्च नहीं कर सकता।"
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستاسو د خپل په توګه نه دی نښه شوی: د دې والټ ټوله تاریخچه لوستلی شي. لګښت نشي کولی."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உங்கள் சொந்தமானதாகக் குறிக்கப்படவில்லை: இது இந்த வாலட்டின் முழு வரலாற்றையும் படிக்க முடியும். செலவு செய்ய முடியாது."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کا اپنا نشان زد نہیں: یہ اس والیٹ کی پوری تاریخ پڑھ سکتا ہے۔ یہ خرچ نہیں کر سکتا۔"
          }
        }
      }
    },
