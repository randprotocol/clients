    "That amount is more than the pool can hold." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That amount is more than the pool can hold."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا المبلغ أكبر مما يتسع له المجمّع."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Betrag ist mehr, als der Pool halten kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ese monto es mayor de lo que el pool puede contener."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این مقدار بیش از ظرفیت استخر است."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce montant dépasse ce que le pool peut contenir."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jumlah itu melebihi kapasitas pool."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quell'importo è più di quanto il pool possa contenere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "その金額はプールが扱える量を超えています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "풀이 감당할 수 있는 것보다 큰 금액입니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amaun itu melebihi apa yang boleh dipegang oleh kolam."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta kwota przekracza możliwości puli."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esse valor é maior do que o pool comporta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта сумма больше, чем может вместить пул."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该金额超出了资金池的容量。"
          }
        },
        "zh-Hant-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "該金額超出資金池所能承受的數量。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह राशि पूल की क्षमता से अधिक है।"
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دا اندازه له هغه څخه زیاته ده چې پول یې ساتلی شي."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "அந்தத் தொகை பூல் வைத்திருக்கக்கூடியதை விட அதிகம்."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یہ رقم اس سے زیادہ ہے جتنی پول رکھ سکتا ہے۔"
          }
        }
      }
    },
    "That amount is too small: it would buy nothing." : {
      "localizations" : {
