    "No activity yet. Transactions you send or receive will appear here." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No activity yet. Transactions you send or receive will appear here."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يوجد نشاط بعد. ستظهر هنا المعاملات التي ترسلها أو تستلمها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch keine Aktivität. Transaktionen, die du sendest oder empfängst, erscheinen hier."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todavía no hay actividad. Las transacciones que envíes o recibas aparecerán aquí."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هنوز فعالیتی نیست. تراکنش‌هایی که ارسال یا دریافت می‌کنید اینجا نمایش داده می‌شوند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune activité pour l'instant. Les transactions que vous envoyez ou recevez apparaîtront ici."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belum ada aktivitas. Transaksi yang Anda kirim atau terima akan muncul di sini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ancora nessuna attività. Le transazioni che invii o ricevi compariranno qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アクティビティはまだありません。送受信したトランザクションがここに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 활동이 없습니다. 보내거나 받은 거래가 여기에 표시됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belum ada aktiviti. Transaksi yang anda hantar atau terima akan dipaparkan di sini."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brak aktywności. Tutaj pojawią się transakcje, które wyślesz lub odbierzesz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhuma atividade ainda. As transações que você enviar ou receber vão aparecer aqui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пока нет активности. Здесь появятся отправленные и полученные транзакции."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暂无活动。你发送或收到的交易会显示在这里。"
          }
        },
        "zh-Hant-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暫時未有記錄。你傳送或收到的交易會在這裡顯示。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अभी कोई गतिविधि नहीं। आपके भेजे या प्राप्त किए गए लेन-देन यहाँ दिखेंगे।"
