        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@اکنون به اثبات‌گرهای %@ دسترسی نیست (%@). بعداً دوباره امتحان کنید، یا اثبات‌گر خودتان را در تنظیمات جفت کنید."
          }
        },
        "fr" : {
