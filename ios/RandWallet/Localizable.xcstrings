    "Keep the app open. Closing it before it says submitted stops the swap, and nothing is lost." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep the app open. Closing it before it says submitted stops the swap, and nothing is lost."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أبقِ التطبيق مفتوحًا. إغلاقه قبل أن يُعلن الإرسال يوقف المبادلة، ولا يضيع شيء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass die App geöffnet. Schließt du sie, bevor übermittelt angezeigt wird, stoppt der Tausch, und nichts geht verloren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén la app abierta. Cerrarla antes de que diga enviado detiene el intercambio, y no se pierde nada."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برنامه را باز نگه دارید. بستن آن پیش از اعلام ارسال، سواپ را متوقف می‌کند و چیزی از دست نمی‌رود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez l'application ouverte. La fermer avant qu'elle n'indique « soumis » arrête l'échange, et rien n'est perdu."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biarkan aplikasi tetap terbuka. Menutupnya sebelum tertulis dikirimkan akan menghentikan penukaran, dan tidak ada yang hilang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni l'app aperta. Chiuderla prima che indichi «inviato» interrompe lo scambio, e non si perde nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリを開いたままにしてください。送信済みと表示される前に閉じるとスワップは停止しますが、失われるものはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱을 열어 두세요. 제출됨으로 표시되기 전에 닫으면 스왑이 중지되며, 잃는 것은 없습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biarkan aplikasi terbuka. Menutupnya sebelum ia menyatakan diserahkan akan menghentikan pertukaran, dan tiada apa yang hilang."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie zamykaj aplikacji. Zamknięcie jej, zanim pokaże „przesłano”, zatrzymuje wymianę i nic nie zostaje utracone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha o app aberto. Fechá-lo antes de dizer enviada interrompe a troca, e nada se perde."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не закрывайте приложение. Если закрыть его до сообщения об отправке, обмен остановится, но ничего не потеряется."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请保持应用打开。在显示“已提交”之前关闭应用会中止兑换，但不会有任何损失。"
          }
        },
        "zh-Hant-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請保持應用程式開啟。在顯示已提交之前關閉它會中止兌換，但不會有任何損失。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप खुला रखें। सबमिट हुआ दिखने से पहले इसे बंद करने पर स्वैप रुक जाता है, और कुछ भी नहीं खोता।"
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اپ خلاص وساتئ. که د «وسپارل شو» له ویلو مخکې یې بند کړئ، تبادله درېږي، او هېڅ شی نه ورکېږي."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ஆப்பைத் திறந்தே வையுங்கள். சமர்ப்பிக்கப்பட்டது எனக் காட்டுவதற்கு முன் மூடினால் ஸ்வாப் நின்றுவிடும், எதுவும் இழக்கப்படாது."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ایپ کھلی رکھیں۔ \"جمع کر دیا گیا\" دکھانے سے پہلے اسے بند کرنے سے سواپ رک جاتا ہے، اور کچھ ضائع نہیں ہوتا۔"
          }
        }
      }
    },
