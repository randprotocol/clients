        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உங்கள் இணைக்கப்பட்ட நிரூபிப்பான் பெரிய நிரூபணத்தை உருவாக்கும்; இந்தச் சாதனம் சிறியவற்றை உருவாக்கும். இதற்குச் சில நிமிடங்கள் ஆகும்."
          }
