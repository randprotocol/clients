    "Your paired prover makes the large proof; this device makes the small ones. It takes a few minutes." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your paired prover makes the large proof; this device makes the small ones. It takes a few minutes."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُعِدّ مُثبِتك المقترن الإثبات الكبير، ويُعِدّ هذا الجهاز الإثباتات الصغيرة. يستغرق ذلك بضع دقائق."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein gekoppelter Prover erstellt den großen Beweis; dieses Gerät die kleinen. Es dauert ein paar Minuten."
