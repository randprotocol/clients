    "The RandProtocol provers: %lld machines run by the validators, each with its own key, used until you choose another. They charge nothing. %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The RandProtocol provers: %1$lld machines run by the validators, each with its own key, used until you choose another. They charge nothing. %2$@"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مُثبِتات RandProtocol: %lld جهاز يشغّلها المدقّقون، لكلٍّ منها مفتاحه، تُستخدم حتى تختار غيرها. لا تتقاضى شيئًا. %@"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die RandProtocol-Prover: %lld Rechner, betrieben von den Validatoren, jeder mit eigenem Schlüssel, genutzt, bis du einen anderen wählst. Sie verlangen nichts. %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los probadores de RandProtocol: %lld máquinas administradas por los validadores, cada una con su propia clave, que se usan hasta que elijas otro. No cobran nada. %@"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اثبات‌گرهای RandProtocol: %lld دستگاه که اعتبارسنج‌ها اداره می‌کنند، هر کدام با کلید خودش، که تا وقتی دیگری را انتخاب کنید استفاده می‌شوند. هزینه‌ای نمی‌گیرند. %@"
          }
        },
        "fr" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Les prouveurs RandProtocol : %lld machine gérée par les validateurs, avec sa propre clé, utilisée jusqu'à ce que vous en choisissiez un autre. Ils ne facturent rien. %@"
                }
              },
              "many" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Les prouveurs RandProtocol : %lld machines gérées par les validateurs, chacune avec sa propre clé, utilisées jusqu'à ce que vous en choisissiez un autre. Ils ne facturent rien. %@"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Les prouveurs RandProtocol : %lld machines gérées par les validateurs, chacune avec sa propre clé, utilisées jusqu'à ce que vous en choisissiez un autre. Ils ne facturent rien. %@"
                }
              }
            }
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prover RandProtocol: %lld mesin yang dijalankan oleh validator, masing-masing dengan kuncinya sendiri, digunakan sampai Anda memilih yang lain. Semuanya gratis. %@"
          }
        },
        "it" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "I prover di RandProtocol: %lld macchina gestita dai validatori, con la propria chiave, usata finché non ne scegli un altro. Non costano nulla. %@"
                }
              },
              "many" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "I prover di RandProtocol: %lld macchine gestite dai validatori, ognuna con la propria chiave, usate finché non ne scegli un altro. Non costano nulla. %@"
                }
