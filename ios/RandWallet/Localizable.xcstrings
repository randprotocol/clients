    "The sender's pk identifies who paid you to anyone holding your viewing key, and nobody else." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The sender's pk identifies who paid you to anyone holding your viewing key, and nobody else."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يكشف pk المُرسِل مَن دفع لك لكل من يملك مفتاح العرض الخاص بك، ولا أحد غيره."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die pk des Absenders zeigt jedem, der deinen Ansichtsschlüssel hat, wer dich bezahlt hat – und sonst niemandem."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pk del remitente identifica quién te pagó ante cualquiera que tenga tu clave de visualización, y ante nadie más."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "pk فرستنده برای هر کسی که کلید مشاهده‌ی شما را دارد، و هیچ کس دیگر، مشخص می‌کند چه کسی به شما پرداخت کرده است."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pk de l'expéditeur indique qui vous a payé à toute personne détenant votre clé de visualisation, et à personne d'autre."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "pk pengirim menunjukkan siapa yang membayar Anda kepada siapa pun yang memegang kunci tampilan Anda, dan tidak kepada orang lain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pk del mittente indica chi ti ha pagato a chiunque possieda la tua chiave di visualizzazione, e a nessun altro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "送信者の pk から誰が支払ったかがわかるのは、あなたの閲覧キーを持つ人だけです。"
