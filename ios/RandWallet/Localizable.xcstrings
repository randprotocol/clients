        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@Prover %@ tidak dapat dijangkau saat ini (%@). Coba lagi nanti, atau pasangkan prover milik Anda sendiri di Pengaturan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@I prover di %@ non sono raggiungibili in questo momento (%@). Riprova più tardi, oppure associa un tuo prover nelle Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@現在 %@ のプルーバーに接続できません（%@）。後でもう一度試すか、設定で自分のプルーバーをペアリングしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@지금은 %@ 프루버에 연결할 수 없습니다(%@). 나중에 다시 시도하거나, 설정에서 직접 운영하는 프루버를 페어링하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@Pembukti %@ tidak dapat dicapai sekarang (%@). Cuba lagi kemudian, atau pasangkan pembukti anda sendiri dalam Tetapan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@Provery %@ są teraz nieosiągalne (%@). Spróbuj ponownie później lub sparuj własny prover w Ustawieniach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@Os provadores %@ não podem ser alcançados agora (%@). Tente mais tarde ou pareie seu próprio provador em Configurações."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@С пруверами %@ сейчас не удаётся связаться (%@). Попробуйте позже или подключите свой прувер в настройках."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@目前无法连接 %@ 证明器（%@）。请稍后重试，或在设置中配对你自己的证明器。"
          }
        },
        "zh-Hant-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@目前無法連接 %@ 證明器（%@）。請稍後再試，或在設定中配對你自己的證明器。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@%@ प्रूवर तक अभी पहुँचा नहीं जा सकता (%@)। बाद में फिर से कोशिश करें, या सेटिंग्स में अपना खुद का प्रूवर पेयर करें।"
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@د %@ ثبوت جوړوونکو ته اوس لاسرسی نشته (%@). وروسته بیا هڅه وکړئ، یا په امستنو کې خپل ثبوت جوړوونکی جوړه کړئ."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@%@ நிரூபிப்பான்களை இப்போது அணுக முடியவில்லை (%@). பின்னர் மீண்டும் முயலவும், அல்லது அமைப்புகளில் உங்கள் சொந்த நிரூபிப்பானை இணைக்கவும்."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@%@ پروور تک اس وقت رسائی نہیں ہو سکتی (%@)۔ بعد میں دوبارہ کوشش کریں، یا ترتیبات میں اپنا پروور جوڑیں۔"
          }
        }
      }
    },
