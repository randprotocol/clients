          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இன்னும் செயல்பாடு இல்லை. நீங்கள் அனுப்பும் அல்லது பெறும் பரிவர்த்தனைகள் இங்கே தோன்றும்."
          }
