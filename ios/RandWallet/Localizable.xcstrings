    "Priced by the durian.market pools on this chain (%@%% pool fee). The swap is a transaction this wallet proves and sends itself." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Priced by the durian.market pools on this chain (%@%% pool fee). The swap is a transaction this wallet proves and sends itself."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مُسعَّر وفق مجمّعات durian.market على هذه السلسلة (رسوم المجمّع %@%%). المبادلة معاملة تُثبتها هذه المحفظة وترسلها بنفسها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bepreist von den durian.market-Pools auf dieser Chain (%@ %% Pool-Gebühr). Der Tausch ist eine Transaktion, die diese Wallet selbst beweist und sendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Precio según los pools de durian.market en esta cadena (%@%% de comisión del pool). El intercambio es una transacción que esta billetera prueba y envía por sí misma."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قیمت‌گذاری با استخرهای durian.market در این شبکه (%@%% کارمزد استخر). سواپ تراکنشی است که این کیف پول خودش اثبات و ارسال می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prix fixé par les pools durian.market sur cette chaîne (%@ %% de frais de pool). L'échange est une transaction que ce portefeuille prouve et envoie lui-même."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harga dari pool durian.market di chain ini (biaya pool %@%%). Penukaran adalah transaksi yang dibuktikan dan dikirim sendiri oleh dompet ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prezzo fissato dai pool di durian.market su questa catena (commissione del pool %@%%). Lo scambio è una transazione che questo portafoglio prova e invia da sé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このチェーンの durian.market プールによる価格です（プール手数料 %@%%）。スワップは、このウォレット自身が証明して送信するトランザクションです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 체인의 durian.market 풀 기준 가격입니다(풀 수수료 %@%%). 스왑은 이 지갑이 직접 증명하고 보내는 거래입니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harga ditentukan oleh kolam durian.market di rantaian ini (yuran kolam %@%%). Pertukaran ini ialah transaksi yang dibuktikan dan dihantar oleh dompet ini sendiri."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wycena według pul durian.market w tym łańcuchu (opłata puli %@%%). Wymiana to transakcja, której dowód ten portfel generuje i którą wysyła sam."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preço dos pools durian.market nesta cadeia (taxa do pool de %@%%). A troca é uma transação que esta carteira prova e envia ela mesma."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цена — по пулам durian.market в этой сети (комиссия пула %@%%). Обмен — это транзакция, которую кошелёк сам доказывает и отправляет."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按此链上 durian.market 资金池定价（资金池手续费 %@%%）。兑换是一笔由此钱包自行生成证明并发送的交易。"
          }
        },
        "zh-Hant-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按此鏈上 durian.market 資金池定價（資金池費用 %@%%）。兌換是一筆由此錢包自行生成證明並傳送的交易。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस चेन पर durian.market पूल द्वारा मूल्य निर्धारित (%@%% पूल शुल्क)। स्वैप एक लेन-देन है जिसका प्रूफ़ यह वॉलेट खुद बनाता है और भेजता है।"
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بیه یې پر دې زنځیر د durian.market د پولونو له مخې ټاکل شوې (د پول فیس %@%%). تبادله یوه راکړه ورکړه ده چې دا والټ پخپله یې ثبوت جوړوي او لېږي."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இந்தச் செயினில் உள்ள durian.market பூல்களால் விலை நிர்ணயிக்கப்படுகிறது (%@%% பூல் கட்டணம்). ஸ்வாப் என்பது இந்த வாலட்டே நிரூபித்து அனுப்பும் ஒரு பரிவர்த்தனை."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قیمت اس چین پر durian.market کے پولز سے طے ہوتی ہے (%@%% پول فیس)۔ سواپ ایک لین دین ہے جس کا پروف یہ والیٹ خود بناتا اور بھیجتا ہے۔"
          }
        }
      }
    },
