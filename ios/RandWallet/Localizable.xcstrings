    "need more than two notes; the largest two hold %@ — consolidate first by sending to your own address" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "need more than two notes; the largest two hold %@ — consolidate first by sending to your own address"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يلزم أكثر من سندين، وأكبر سندين يحملان %@ — ادمج سنداتك أولًا بالإرسال إلى عنوانك"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mehr als zwei Noten nötig; die beiden größten halten %@ – fasse sie zuerst zusammen, indem du an deine eigene Adresse sendest"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "se necesitan más de dos notas; las dos mayores suman %@; consolida primero enviando a tu propia dirección"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بیش از دو نوت لازم است؛ دو نوت بزرگ‌تر %@ دارند — ابتدا با ارسال به آدرس خودتان آن‌ها را یکپارچه کنید"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "il faut plus de deux notes ; les deux plus grosses contiennent %@ : consolidez d'abord en envoyant à votre propre adresse"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "diperlukan lebih dari dua catatan; dua catatan terbesar berisi %@ — gabungkan dulu dengan mengirim ke alamat Anda sendiri"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "servono più di due note; le due più grandi contengono %@ — consolida prima inviando al tuo stesso indirizzo"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3つ以上のノートが必要です。最大の2つの合計は %@ です。先に自分のアドレスへ送信してノートをまとめてください"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "노트가 세 개 이상 필요합니다. 가장 큰 두 노트의 합계는 %@입니다 — 먼저 내 주소로 보내 노트를 통합하세요"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "memerlukan lebih daripada dua nota; dua yang terbesar memegang %@ — satukan dahulu dengan menghantar ke alamat anda sendiri"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "potrzeba więcej niż dwóch not; dwie największe zawierają %@ — najpierw je scal, wysyłając na własny adres"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "são necessárias mais de duas notas; as duas maiores somam %@ — consolide primeiro enviando para seu próprio endereço"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "нужно больше двух нот; в двух крупнейших %@ — сначала объедините их, отправив средства на свой адрес"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要两个以上的票据；最大的两个票据共有 %@——请先向自己的地址发送以合并票据"
          }
        },
        "zh-Hant-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要多於兩張票據；最大的兩張共持有 %@，請先傳送到你自己的地址以合併"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दो से अधिक नोट चाहिए; सबसे बड़े दो नोट में %@ है — पहले अपने ही पते पर भेजकर इन्हें समेकित करें"
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "له دوو څخه زیات نوټونه اړین دي؛ دوه تر ټولو لوی %@ لري — لومړی خپلې پتې ته په لېږلو یې سره یو ځای کړئ"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இரண்டுக்கு மேற்பட்ட நோட்டுகள் தேவை; பெரிய இரண்டில் %@ உள்ளது — முதலில் உங்கள் சொந்த முகவரிக்கு அனுப்பி ஒருங்கிணைக்கவும்"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دو سے زیادہ نوٹ درکار ہیں؛ سب سے بڑے دو میں %@ ہے — پہلے اپنے ہی پتے پر بھیج کر انہیں یکجا کریں"
          }
        }
      }
    },
