    "Forgetting it goes back to the RandProtocol provers." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forgetting it goes back to the RandProtocol provers."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نسيانه يعيدك إلى مُثبِتات RandProtocol."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du ihn vergisst, werden wieder die RandProtocol-Prover genutzt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al olvidarlo se vuelve a los probadores de RandProtocol."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "با فراموش کردن آن، دوباره از اثبات‌گرهای RandProtocol استفاده می‌شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'oublier ramène aux prouveurs RandProtocol."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika dilupakan, kembali ke prover RandProtocol."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dimenticandolo si torna ai prover di RandProtocol."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "解除すると RandProtocol のプルーバーに戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "삭제하면 RandProtocol 프루버로 돌아갑니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melupakannya akan kembali kepada pembukti RandProtocol."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po zapomnieniu wracasz do proverów RandProtocol."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao esquecê-lo, volta-se aos provadores da RandProtocol."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если забыть его, снова будут использоваться пруверы RandProtocol."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "忘记后将改回使用 RandProtocol 证明器。"
          }
        },
        "zh-Hant-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "忘記它後會改回使用 RandProtocol 證明器。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसे भूलने पर फिर से RandProtocol प्रूवर इस्तेमाल होंगे।"
          }
        },
        "ps" : {
