          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pembukti yang dipasangkan membuat bukti besar; peranti ini membuat bukti-bukti kecil. Ia mengambil masa beberapa minit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twój sparowany prover generuje duży dowód; to urządzenie generuje małe. To zajmuje kilka minut."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu provador pareado gera a prova grande; este dispositivo gera as pequenas. Leva alguns minutos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
