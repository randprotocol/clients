    "%@ Your paired prover is not available: %@." : {
      "comment" : "First %@ is a preceding sentence (may be empty); second is the reason.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Your paired prover is not available: %2$@."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ مُثبِتك المقترن غير متاح: %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Dein gekoppelter Prover ist nicht verfügbar: %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Tu probador vinculado no está disponible: %@."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ اثبات‌گر جفت‌شده‌ی شما در دسترس نیست: %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Votre prouveur associé n'est pas disponible : %@."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Prover yang dipasangkan tidak tersedia: %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Il tuo prover associato non è disponibile: %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ペアリング済みのプルーバーを利用できません: %@。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 페어링된 프루버를 사용할 수 없습니다: %@."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Pembukti yang dipasangkan tidak tersedia: %@."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Twój sparowany prover jest niedostępny: %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Seu provador pareado não está disponível: %@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Ваш подключённый прувер недоступен: %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@你配对的证明器不可用：%@。"
          }
        },
        "zh-Hant-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@你已配對的證明器無法使用：%@。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ आपका पेयर किया गया प्रूवर उपलब्ध नहीं है: %@।"
