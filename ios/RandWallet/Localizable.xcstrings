    "Use https for a prover — plain http is only allowed for a prover on this machine." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use https for a prover — plain http is only allowed for a prover on this machine."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم https للمُثبِت — لا يُسمح بـ http العادي إلا لمُثبِت على هذا الجهاز."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwende https für einen Prover – einfaches http ist nur für einen Prover auf diesem Rechner erlaubt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa https para un probador: http sin cifrar solo se permite para un probador en esta máquina."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای اثبات‌گر از https استفاده کنید — http ساده فقط برای اثبات‌گری روی همین دستگاه مجاز است."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez https pour un prouveur : le http non chiffré n'est autorisé que pour un prouveur sur cette machine."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gunakan https untuk prover — http biasa hanya diizinkan untuk prover di mesin ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa https per un prover — il semplice http è consentito solo per un prover su questa macchina."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プルーバーには https を使ってください。暗号化されていない http は、このマシン上のプルーバーにのみ使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프루버에는 https를 사용하세요 — 일반 http는 이 머신의 프루버에만 허용됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gunakan https untuk pembukti — http biasa hanya dibenarkan untuk pembukti pada mesin ini."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Użyj https dla provera — zwykłe http jest dozwolone tylko dla provera na tej maszynie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use https para um provador — http simples só é permitido para um provador nesta máquina."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте https для прувера — обычный http допустим только для прувера на этом компьютере."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "证明器请使用 https——只有本机上的证明器才允许使用普通 http。"
          }
        },
        "zh-Hant-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "證明器請使用 https；只有本機上的證明器才可使用 http。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रूवर के लिए https इस्तेमाल करें — सादा http केवल इसी मशीन पर चल रहे प्रूवर के लिए अनुमत है।"
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "د ثبوت جوړوونکي لپاره https وکاروئ — ساده http یوازې په همدې ماشین کې د ثبوت جوړوونکي لپاره اجازه لري."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "நிரூபிப்பானுக்கு https பயன்படுத்தவும் — வெறும் http இந்தக் கணினியில் உள்ள நிரூபிப்பானுக்கு மட்டுமே அனுமதிக்கப்படும்."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پروور کے لیے https استعمال کریں — سادہ http کی اجازت صرف اسی مشین پر موجود پروور کے لیے ہے۔"
          }
        }
      }
    },
