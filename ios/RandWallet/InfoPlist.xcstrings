          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rand Wallet использует Face ID, чтобы разблокировать ваш кошелёк."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rand Wallet 使用面容 ID 解锁你的钱包。"
          }
        },
        "zh-Hant-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rand Wallet 會使用 Face ID 解鎖你的錢包。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rand Wallet आपका वॉलेट अनलॉक करने के लिए Face ID का उपयोग करता है।"
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rand Wallet ستاسو د والټ د خلاصولو لپاره Face ID کاروي."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உங்கள் வாலட்டைத் திறக்க Rand Wallet Face ID-ஐப் பயன்படுத்துகிறது."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rand Wallet آپ کا والیٹ ان لاک کرنے کے لیے Face ID استعمال کرتا ہے۔"
