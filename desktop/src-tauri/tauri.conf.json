{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rand Wallet",
  "version": "0.1.0",
  "identifier": "org.randprotocol.wallet.desktop",
  "build": {
    "frontendDist": "../dist-ui",
    "beforeDevCommand": { "script": "desktop/scripts/stage-ui.sh", "cwd": "../.." },
    "beforeBuildCommand": { "script": "desktop/scripts/stage-ui.sh", "cwd": "../.." }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Rand Wallet",
        "width": 1100,
        "height": 760,
        "minWidth": 380,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost https: http://127.0.0.1:* http://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "msi", "appimage", "deb"],
    "icon": [
      "../assets/icons/32x32.png",
      "../assets/icons/128x128.png",
      "../assets/icons/128x128@2x.png",
      "../assets/icons/icon.icns",
      "../assets/icons/icon.ico"
    ],
    "category": "Finance",
    "shortDescription": "A shielded wallet for RAND",
    "longDescription": "Rand Wallet holds RAND in shielded notes, scans a node's commitment tree locally, and proves transfers on this computer. Keys never leave the machine."
  }
}
