{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "short_name": "__MSG_appShortName__",
  "version": "0.7.2",
  "description": "__MSG_appDescription__",
  "default_locale": "en",
  "author": "RandProtocol Contributors",
  "homepage_url": "https://randprotocol.org/clients",
  "browser_specific_settings": {
    "gecko": {
      "id": "wallet@randprotocol.org",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ],
        "optional": [
          "financialAndPaymentInfo"
        ]
      }
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "sidebar_action": {
    "default_panel": "sidepanel.html",
    "default_title": "__MSG_sidebarTitle__",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "open_at_install": false
  },
  "background": {
    "scripts": [
      "provider-host.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://randbridge.org/*",
        "https://*.randbridge.org/*",
        "https://durian.market/*",
        "https://www.durian.market/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "inpage.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://randbridge.org/*",
        "https://*.randbridge.org/*",
        "https://durian.market/*",
        "https://www.durian.market/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "options_ui": {
    "page": "app.html#settings",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "https://rpc.randprotocol.org/*",
    "https://rpc1.randprotocol.org/*",
    "https://rpc2.randprotocol.org/*",
    "https://rpc3.randprotocol.org/*",
    "https://prover.randprotocol.org/*",
    "https://randbridge.org/*",
    "https://*.randbridge.org/*",
    "https://durian.market/*",
    "https://www.durian.market/*"
  ],
  "optional_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
