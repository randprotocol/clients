<?xml version="1.0" encoding="utf-8"?>
<!-- Inter, the UI face (design/tokens.json `type.family`): one variable file, four named weights, so
     a bold TextView gets the real 700 instance and never a synthetic bold. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font android:font="@font/inter_variable" android:fontWeight="400" android:fontStyle="normal" android:fontVariationSettings="'wght' 400" />
    <font android:font="@font/inter_variable" android:fontWeight="500" android:fontStyle="normal" android:fontVariationSettings="'wght' 500" />
    <font android:font="@font/inter_variable" android:fontWeight="600" android:fontStyle="normal" android:fontVariationSettings="'wght' 600" />
    <font android:font="@font/inter_variable" android:fontWeight="700" android:fontStyle="normal" android:fontVariationSettings="'wght' 700" />
</font-family>
