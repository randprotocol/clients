<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.RandWallet" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="colorPrimaryContainer">@color/surface_2</item>
        <item name="colorOnPrimaryContainer">@color/text</item>
        <item name="colorSecondary">@color/accent_2</item>
        <item name="colorOnSecondary">@color/on_accent</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="colorSurfaceVariant">@color/surface_2</item>
        <item name="colorOnSurfaceVariant">@color/text_soft</item>
        <item name="colorOutline">@color/border</item>
        <item name="colorOutlineVariant">@color/border_soft</item>
        <item name="colorError">@color/negative</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">@bool/light_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_bars</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_soft</item>
        <item name="android:textColorHint">@color/text_mute</item>
        <item name="materialButtonStyle">@style/Widget.RandWallet.Button</item>
        <item name="textInputStyle">@style/Widget.Material3.TextInputLayout.OutlinedBox</item>
    </style>

    <style name="Widget.RandWallet.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.RandWallet.Button.Secondary" parent="Widget.Material3.Button.TonalButton">
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="backgroundTint">@color/surface_2</item>
        <item name="android:textColor">@color/text</item>
    </style>

    <style name="Widget.RandWallet.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/accent</item>
    </style>

    <style name="Text" />
    <style name="Text.Balance">
        <item name="android:textSize">40sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/field_grain</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>
    <style name="Text.Title">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_strong</item>
    </style>
    <style name="Text.Section">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_strong</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="Text.Body">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_soft</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
    </style>
    <style name="Text.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_mute</item>
    </style>
    <style name="Text.Mono">
        <item name="android:typeface">monospace</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text</item>
    </style>
    <style name="Text.Amount">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>
</resources>
