<?xml version="1.0" encoding="utf-8"?>
<!-- The brand as the shared UI's topbar draws it (ui/base.css .brand): the mark at 22dp and the
     lowercase `rand` wordmark in the pixel face at 22sp, 10dp apart. Read aloud as "Rand Wallet". -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content" android:layout_height="44dp"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:contentDescription="@string/app_name">
    <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_mark" android:importantForAccessibility="no" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" style="@style/Text.Wordmark" android:text="@string/wordmark" android:importantForAccessibility="no" />
</LinearLayout>
