<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp" android:gravity="center_horizontal">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Text.Title" android:text="@string/receive_title" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" style="@style/Text.Body" android:text="@string/receive_body" />
    <ImageView android:id="@+id/qr" android:layout_width="300dp" android:layout_height="300dp" android:layout_marginTop="20dp" android:padding="12dp" android:background="@color/white" android:scaleType="fitCenter" android:contentDescription="@string/receive_qr_description" />
    <TextView android:id="@+id/qr_too_long" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" style="@style/Text.Body" android:textColor="@color/warning" android:text="@string/receive_qr_too_long" android:visibility="gone" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" style="@style/Text.Caption" android:text="@string/receive_fingerprint" />
    <TextView android:id="@+id/fingerprint" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" style="@style/Text.Mono" android:textSize="18sp" android:textStyle="bold" android:textIsSelectable="true" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center" style="@style/Text.Caption" android:text="@string/receive_fingerprint_note" />
    <TextView android:id="@+id/address" android:layout_width="match_parent" android:layout_height="120dp" android:layout_marginTop="16dp" android:padding="14dp" android:background="@drawable/bg_surface_card" style="@style/Text.Mono" android:textSize="11sp" android:scrollbars="vertical" android:textIsSelectable="true" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton android:id="@+id/copy" style="@style/Widget.RandWallet.Button.Secondary" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginEnd="6dp" android:text="@string/receive_copy" />
        <com.google.android.material.button.MaterialButton android:id="@+id/copy_link" style="@style/Widget.RandWallet.Button.Secondary" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="@string/receive_copy_link" />
    </LinearLayout>
    <com.google.android.material.button.MaterialButton android:id="@+id/share" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/receive_share" />

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" style="@style/Text.Section" android:text="@string/receive_link_title" />
    <TextView android:id="@+id/link_body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" style="@style/Text.Caption" android:text="@string/receive_link_body" />
    <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:hint="@string/receive_amount_hint" app:suffixText="RAND">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/amount" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" />
    </com.google.android.material.textfield.TextInputLayout>
    <LinearLayout android:id="@+id/memo_group" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="@string/receive_memo_hint">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/memo" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textMultiLine|textNoSuggestions" android:maxLines="4" />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView android:id="@+id/memo_counter" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="end" style="@style/Text.Caption" />
    </LinearLayout>
    <TextView android:id="@+id/link_error" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/negative" android:textSize="13sp" />
</LinearLayout>
</ScrollView>
