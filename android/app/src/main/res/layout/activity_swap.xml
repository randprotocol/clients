<?xml version="1.0" encoding="utf-8"?>
<!-- Swap: form → review → running → done | failed, as ui/screens/swap.js. Page 0 is the wait
     while the pools are read, and what the screen says when there is nothing to swap through. -->
<ViewFlipper xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/flipper" android:layout_width="match_parent" android:layout_height="match_parent">

    <!-- 0: loading / unavailable -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:padding="28dp">
        <com.google.android.material.progressindicator.CircularProgressIndicator android:id="@+id/loading" android:layout_width="wrap_content" android:layout_height="wrap_content" android:indeterminate="true" app:indicatorColor="@color/accent" />
        <ImageView android:id="@+id/unavailable_icon" android:layout_width="72dp" android:layout_height="72dp" android:padding="20dp" android:background="@drawable/bg_action_circle" android:src="@drawable/ic_swap" android:contentDescription="@null" android:visibility="gone" />
        <TextView android:id="@+id/unavailable_message" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:gravity="center" style="@style/Text.Body" />
        <com.google.android.material.button.MaterialButton android:id="@+id/open_durian" style="@style/Widget.RandWallet.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/swap_open_durian" android:visibility="gone" />
        <com.google.android.material.button.MaterialButton android:id="@+id/unavailable_home" style="@style/Widget.RandWallet.Button.Text" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/swap_back_home" android:visibility="gone" />
    </LinearLayout>

    <!-- 1: form -->
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Text.Title" android:text="@string/swap_title" />
        <TextView android:id="@+id/notice" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:padding="12dp" android:background="@drawable/bg_surface_card" style="@style/Text.Body" android:textColor="@color/warning" android:visibility="gone" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="20dp">
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" style="@style/Text.Caption" android:text="@string/swap_pay" />
            <com.google.android.material.button.MaterialButton android:id="@+id/max" style="@style/Widget.RandWallet.Button.Text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/send_max" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <com.google.android.material.textfield.TextInputLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:hint="@string/swap_amount_hint">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/amount" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" android:textSize="22sp" android:fontFeatureSettings="tnum" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/sell" style="@style/Widget.RandWallet.Button.Secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:minWidth="96dp" />
        </LinearLayout>
        <TextView android:id="@+id/available" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Text.Caption" android:layout_marginTop="4dp" />
        <TextView android:id="@+id/amount_error" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/negative" android:textSize="13sp" android:visibility="gone" />

        <ImageButton android:id="@+id/flip" android:layout_width="44dp" android:layout_height="44dp" android:layout_gravity="center_horizontal" android:layout_marginTop="8dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_swap" android:contentDescription="@string/swap_flip" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" style="@style/Text.Caption" android:text="@string/swap_receive" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/out" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" style="@style/Text.Amount" android:textSize="22sp" android:text="@string/placeholder_dash" />
            <com.google.android.material.button.MaterialButton android:id="@+id/buy" style="@style/Widget.RandWallet.Button.Secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:minWidth="96dp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/details" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical" android:padding="16dp" android:background="@drawable/bg_surface_card" android:visibility="gone">
            <include android:id="@+id/d_rate" layout="@layout/view_detail_row" />
            <include android:id="@+id/d_impact" layout="@layout/view_detail_row" />
            <include android:id="@+id/d_fee" layout="@layout/view_detail_row" />
            <include android:id="@+id/d_route" layout="@layout/view_detail_row" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/review" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/swap_review" android:enabled="false" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" style="@style/Text.Caption" android:text="@string/swap_caption" />
    </LinearLayout>
    </ScrollView>

    <!-- 2: review -->
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Text.Title" android:text="@string/swap_review_title" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:orientation="vertical" android:padding="16dp" android:background="@drawable/bg_surface_card">
            <include android:id="@+id/r_pay" layout="@layout/view_detail_row" />
            <include android:id="@+id/r_receive" layout="@layout/view_detail_row" />
            <include android:id="@+id/r_pool_fee" layout="@layout/view_detail_row" />
            <include android:id="@+id/r_network_fee" layout="@layout/view_detail_row" />
            <include android:id="@+id/r_program" layout="@layout/view_detail_row" />
        </LinearLayout>
        <TextView android:id="@+id/r_caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" style="@style/Text.Body" />
        <TextView android:id="@+id/r_notice" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:padding="12dp" android:background="@drawable/bg_surface_card" style="@style/Text.Body" android:textColor="@color/warning" android:visibility="gone" />
        <com.google.android.material.button.MaterialButton android:id="@+id/acknowledge" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/prover_notice_continue" android:visibility="gone" />
        <com.google.android.material.button.MaterialButton android:id="@+id/use_own" style="@style/Widget.RandWallet.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/prover_notice_own" android:visibility="gone" />
        <com.google.android.material.button.MaterialButton android:id="@+id/swap" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/swap_go" />
        <com.google.android.material.button.MaterialButton android:id="@+id/edit" style="@style/Widget.RandWallet.Button.Text" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/swap_edit" />
    </LinearLayout>
    </ScrollView>

    <!-- 3: running -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:padding="28dp">
        <com.google.android.material.progressindicator.CircularProgressIndicator android:layout_width="wrap_content" android:layout_height="wrap_content" android:indeterminate="true" app:indicatorSize="72dp" app:indicatorColor="@color/accent" app:trackThickness="6dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" style="@style/Text.Title" android:text="@string/swap_running_title" />
        <TextView android:id="@+id/phase" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/accent" android:textSize="14sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:padding="12dp" android:background="@drawable/bg_surface_card" style="@style/Text.Body" android:text="@string/swap_running_body" />
        <TextView android:id="@+id/elapsed" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" style="@style/Text.Caption" android:fontFeatureSettings="tnum" />
    </LinearLayout>

    <!-- 4: done / failed -->
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp" android:gravity="center_horizontal">
        <ImageView android:id="@+id/result_icon" android:layout_width="72dp" android:layout_height="72dp" android:layout_marginTop="24dp" android:src="@drawable/ic_check" android:contentDescription="@null" />
        <TextView android:id="@+id/result_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" style="@style/Text.Title" />
        <TextView android:id="@+id/result_amount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" style="@style/Text.Amount" android:textSize="26sp" />
        <TextView android:id="@+id/result_message" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center" style="@style/Text.Body" />
        <LinearLayout android:id="@+id/result_details" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="20dp" android:padding="16dp" android:background="@drawable/bg_surface_card">
            <include android:id="@+id/res_paid" layout="@layout/view_detail_row" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" style="@style/Text.Caption" android:text="@string/sent_hash" />
            <TextView android:id="@+id/result_hash" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.Mono" android:textIsSelectable="true" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" style="@style/Text.Caption" android:text="@string/swap_done_note" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/copy_hash" style="@style/Widget.RandWallet.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/swap_copy_hash" />
        <com.google.android.material.button.MaterialButton android:id="@+id/view_explorer" style="@style/Widget.RandWallet.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/sent_view" />
        <com.google.android.material.button.MaterialButton android:id="@+id/done" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/sent_done" />
        <com.google.android.material.button.MaterialButton android:id="@+id/result_home" style="@style/Widget.RandWallet.Button.Text" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/swap_back_home" />
    </LinearLayout>
    </ScrollView>
</ViewFlipper>
